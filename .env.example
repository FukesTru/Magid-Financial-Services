# Canonical origin used for metadata, sitemap and structured data.
# Change this if the client launches on a domain other than i-mfs.com.
NEXT_PUBLIC_SITE_URL=https://i-mfs.com

# GA4 measurement ID (format: G-XXXXXXXXXX).
# Leave unset and no analytics script is loaded and no cookies are set.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
