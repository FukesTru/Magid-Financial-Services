# Canonical origin used for metadata, sitemap and structured data.
# Change this if the client launches on a domain other than i-mfs.com.
NEXT_PUBLIC_SITE_URL=https://i-mfs.com

# GA4 measurement ID (format: G-XXXXXXXXXX).
# Leave unset and no analytics script is loaded and no cookies are set.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Contact form delivery --------------------------------------------------
# Both of these must be set for the enquiry form to send from the server. While
# either is missing the form does NOT pretend to work: it composes the message
# in the visitor's own email app instead, so an enquiry is never accepted and
# silently dropped. See src/lib/contact.ts.
#
# /contact is statically rendered, so adding these takes effect on the next
# build — set them and redeploy, don't just add them to a running host.
RESEND_API_KEY=
# A sender address on a domain verified with the provider.
CONTACT_FROM_EMAIL=
# Where enquiries land. Defaults to the address published on the site.
CONTACT_TO_EMAIL=

# --- Photography ------------------------------------------------------------
# Unsplash access key, used only by `npm run photos:sync` to resolve the site's
# photography into src/lib/photo-manifest.json. It is a build-time credential:
# it is never bundled, never sent to the browser, and the running site does not
# talk to Unsplash. Deployments do not need it — only whoever re-syncs photos.
# Keys come from https://unsplash.com/oauth/applications
UNSPLASH_ACCESS_KEY=
